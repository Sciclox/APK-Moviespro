# Public base URL used when the backend must construct an HLS proxy URL.
PUBLIC_BASE_URL=https://your-api.example.com

# Comma-separated browser origins. Native Android requests do not need an Origin header.
CORS_ORIGINS=https://your-web-client.example.com

# Optional: replaces the default streaming-provider allowlist.
PROXY_ALLOWED_HOSTS=jkanime.net,jkdesa.com,jkplayers.com,ducvomes.com,yourupload.com,mp4upload.com,filemoon.sx,ok.ru,monoschinos2.com
